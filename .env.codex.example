# Copy to .env.codex and generate this with: openssl rand -hex 32
CODEX_BRIDGE_TOKEN=
CODEX_BRIDGE_MODEL=gpt-6-luna

SUPERMEMORY_DATA_DIR=/data
SUPERMEMORY_PORT=6767
SUPERMEMORY_EMBEDDING_PROVIDER=local
SUPERMEMORY_DISABLE_TELEMETRY=1
SUPERMEMORY_NO_UPDATE_CHECK=1
SUPERMEMORY_INGEST_CONCURRENCY=1
SUPERMEMORY_EMBEDDING_RAM_LIMIT=1gb

# Public MCP origin; existing REST clients keep their current base URL.
SUPERMEMORY_MCP_URL=http://localhost:8443/mcp
